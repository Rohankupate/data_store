{
    "name": "pl_github_sales_ingest_copy_short_data1",
    "properties": {
        "activities": [
            {
                "name": "act_FetchGitHubCSV",
                "type": "WebActivity",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "GET",
                    "url": "https://raw.githubusercontent.com/Rohankupate/data_store/refs/heads/main/short_sales.csv"
                }
            },
            {
                "name": "act_SetRawCSV",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "act_FetchGitHubCSV",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "varRawCSV",
                    "value": {
                        "value": "@activity('act_FetchGitHubCSV').output.response",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "act_FilterValidRows",
                "type": "Filter",
                "dependsOn": [
                    {
                        "activity": "act_SetRawCSV",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@split(variables('varRawCSV'), decodeUriComponent('%0A'))",
                        "type": "Expression"
                    },
                    "condition": {
                        "value": "@and(not(startsWith(item(), 'SalesOrderNumber')), not(equals(trim(item()), '')))",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "act_ForEachRow",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "act_FilterValidRows",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('act_FilterValidRows').output.Value",
                        "type": "Expression"
                    },
                    "isSequential": true,
                    "activities": [
                        {
                            "name": "act_IfHighValue",
                            "type": "IfCondition",
                            "dependsOn": [],
                            "userProperties": [],
                            "typeProperties": {
                                "expression": {
                                    "value": "@or(contains(item(), 'Mountain-100'), contains(item(), 'Road-150'))",
                                    "type": "Expression"
                                },
                                "ifFalseActivities": [
                                    {
                                        "name": "act_AppendStandardValue",
                                        "type": "AppendVariable",
                                        "dependsOn": [],
                                        "userProperties": [],
                                        "typeProperties": {
                                            "variableName": "varStandardLog",
                                            "value": {
                                                "value": "@concat('STANDARD | ', item())",
                                                "type": "Expression"
                                            }
                                        }
                                    }
                                ],
                                "ifTrueActivities": [
                                    {
                                        "name": "act_AppendHighValue",
                                        "type": "AppendVariable",
                                        "dependsOn": [],
                                        "userProperties": [],
                                        "typeProperties": {
                                            "variableName": "varHighLog",
                                            "value": {
                                                "value": "@concat('HIGH | ', item())",
                                                "type": "Expression"
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "name": "act_SetSummaryLog",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "act_ForEachRow",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "varSummaryLog",
                    "value": {
                        "value": "@concat('SUMMARY | Total:', string(length(activity('act_FilterValidRows').output.Value)), ' | High:', string(length(variables('varHighLog'))), ' | Standard:', string(length(variables('varStandardLog'))), ' | At:', utcNow())",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "act_SetRowCount",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "act_SetSummaryLog",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "varRowCount",
                    "value": {
                        "value": "@string(length(activity('act_FilterValidRows').output.Value))",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "act_AuditWait",
                "type": "Wait",
                "dependsOn": [
                    {
                        "activity": "act_SetRowCount",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "waitTimeInSeconds": 1
                }
            }
        ],
        "variables": {
            "varRawCSV": {
                "type": "String"
            },
            "varHighLog": {
                "type": "Array",
                "defaultValue": []
            },
            "varStandardLog": {
                "type": "Array",
                "defaultValue": []
            },
            "varRowCount": {
                "type": "String",
                "defaultValue": "0"
            },
            "varSummaryLog": {
                "type": "String"
            }
        },
        "annotations": [],
        "lastPublishTime": "2026-05-27T11:29:14Z"
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}
